generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────────────────────
// ENUMS - These are fixed lists of options
// ─────────────────────────────────────────

enum Role {
  ADMIN
  SUPERVISOR
}

enum LOB {
  ESPAÑA
  FRANCIA
  IRLANDA
  COORDINACION
}

enum Turno {
  MANANA
  MEDIO
  CIERRE
  NOCTURNO
}

enum TipoEvento {
  VACACION
  AUSENCIA
  NOTA
}

// Label only — for the two-shades-of-green display and for reporting.
// Does NOT decide which balance field gets decremented; every VACACION
// event increments diasVacacionesUsados regardless.
enum OrigenVacacion {
  ANIO_ANTERIOR
  ANIO_ACTUAL
}

// Which balance a NOTA's `horas` value gets subtracted from — unlike
// OrigenVacacion, this one IS branched on in the API, not just a label.
enum TipoHoras {
  MEDICA
  EXCESO
}

// ─────────────────────────────────────────
// MODELS - These become your database tables
// ─────────────────────────────────────────

model User {
  id        String   @id @default(cuid())
  nombre    String
  email     String   @unique
  password  String
  role      Role
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("users")
}

model Empleado {
  id            String   @id @default(cuid())
  nombre        String   @unique 
  lob           LOB
  turno         Turno
  horario       String   @default("")
  activo        Boolean  @default(true)
  
  // Holiday balance
  diasVacaciones        Int   @default(22)
  diasVacacionesUsados  Int   @default(0)

  // Overtime-compensation hours balance — separate pool from vacation
  // days, never merged into the day count
  horasExceso        Float @default(0)
  horasExcesoUsadas  Float @default(0)

  // Medical hours balance
  horasMedicasTotal     Float @default(16)
  horasMedicasUsadas    Float @default(0)

  // Manual grouping/ordering only — no automatic rotation logic
  grupo        Grupo?  @relation(fields: [grupoId], references: [id])
  grupoId      String?
  ordenEnGrupo Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  asignaciones  AsignacionSemanal[]
  eventos       Evento[]

  @@map("empleados")
}

model Tarea {
  id          String  @id @default(cuid())
  nombre      String  @unique
  descripcion String?
  activa      Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  asignaciones AsignacionSemanal[]

  @@map("tareas")
}

model SemanaPlan {
  id          String   @id @default(cuid())
  fechaInicio DateTime @unique // Always Monday
  fechaFin    DateTime // Always Sunday
  publicada   Boolean  @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  asignaciones AsignacionSemanal[]

  @@map("semanas_plan")
}

model AsignacionSemanal {
  id          String   @id @default(cuid())
  diaSemana   Int      // 1=Monday, 2=Tuesday ... 5=Friday
  oficina     Boolean  @default(false)
  notas       String?

  semana    SemanaPlan @relation(fields: [semanaId], references: [id], onDelete: Cascade)
  semanaId  String

  empleado    Empleado @relation(fields: [empleadoId], references: [id])
  empleadoId  String

  tarea     Tarea    @relation(fields: [tareaId], references: [id])
  tareaId   String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("asignaciones_semanales")
}

model Feriado {
  id     String   @id @default(cuid())
  fecha  DateTime @unique
  nombre String   // "Fiesta Nacional de España", "Puente decidido por la empresa"...

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("feriados")
}

model Grupo {
  id     String @id @default(cuid())
  nombre String @unique // "Supervisores", "Grupo 1", "Fines de Semana y Nocturno"...
  orden  Int    @default(0) // display order of the group itself

  empleados Empleado[]

  @@map("grupos")
}

model Evento {
  id        String     @id @default(cuid())
  fecha     DateTime
  tipo      TipoEvento
  notas     String?    // free text; internal only, never sent to public view

  // Only set when tipo = VACACION — which year's days does this look
  // like it came from? Purely descriptive, see comment on the enum above.
  origenVacacion OrigenVacacion?

  // Only set when tipo = AUSENCIA — was it justified? null = still
  // waiting on the agent to explain, needs supervisor follow-up
  justificada Boolean?

  // Only set when tipo = NOTA and hours are being logged against a
  // balance — decides which pool `horas` comes out of. null = a plain
  // note with no hours attached.
  tipoHoras TipoHoras?
  horas     Float?      // hours to subtract from the pool tipoHoras points to

  empleado   Empleado @relation(fields: [empleadoId], references: [id])
  empleadoId String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([empleadoId, fecha]) // one entry per employee per day
  @@map("eventos")
}